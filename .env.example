# ============================================================
# EIP-MMDPP — Environment Configuration TEMPLATE
# Copy to .env and fill in secrets. All variables here mirror the
# canonical set referenced by app/config.py (Settings) and
# docker-compose.yml. Secrets are stubbed with placeholder values.
# ============================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
API_PORT=8005
LOG_LEVEL=INFO
SQL_ECHO=false

# ---------------------------------------------------------------------------
# JWT / Auth
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=300
JWT_REFRESH_TOKEN_EXPIRE_DAYS=70

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5437
POSTGRES_DB=eip
POSTGRES_USER=eip
POSTGRES_PASSWORD=eip_secret

# Explicit overrides (leave blank to derive from POSTGRES_* above).
# The docker-compose api/worker services override these to point at the
# in-network postgres hostname on port 5432.
DATABASE_URL=
DATABASE_URL_SYNC=

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_PORT=6381
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Celery Redis visibility timeout (seconds) — prevents redelivery of long tasks
CELERY_VISIBILITY_TIMEOUT=360000

# ---------------------------------------------------------------------------
# MinIO / Object Storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=eip-raw
MINIO_BUCKET_DERIVED=eip-derived
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# ---------------------------------------------------------------------------
# Text embedding — Pass A (chunked + embedded for retrieval, served by Ollama)
# ---------------------------------------------------------------------------
TEXT_EMBEDDING_MODEL=bge-m3:latest
TEXT_EMBEDDING_DIM=1024
EMBEDDING_CHUNK_MAX_TOKENS=512
EMBEDDING_CHUNK_OVERLAP_TOKENS=64
EMBEDDING_CHUNK_TOKENIZER_MODEL=BAAI/bge-m3
EMBED_TEXT_BATCH_SIZE=128
TEXT_EMBEDDING_BASE_URLS='["http://10.0.1.122:11434"]'

# ---------------------------------------------------------------------------
# Image embedding (OpenCLIP)
# ---------------------------------------------------------------------------
IMAGE_EMBEDDING_MODEL=ViT-L-16-SigLIP2-256
IMAGE_EMBEDDING_PRETRAINED=webli
IMAGE_EMBEDDING_DIM=1024
# SECRET — get from https://huggingface.co/settings/tokens
HF_TOKEN=hf_REPLACE_ME

# ---------------------------------------------------------------------------
# LLM Provider — system-wide (applies to ALL LLM features)
# "ollama" = air-gapped local LLM | "openai" = OpenAI API | "mock" = no LLM
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# OpenAI (only used when LLM_PROVIDER=openai)
# SECRET — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=

# Ollama endpoints. Specific *_BASE_URL variables fall back to OLLAMA_BASE_URL.
#OLLAMA_BASE_URL=http://10.0.1.121:11434
#OLLAMA_LLM_BASE_URL=http://10.0.1.121:11434
#OLLAMA_VLM_BASE_URL=http://10.0.1.121:11434
#OLLAMA_EMBEDDING_BASE_URL=http://10.0.1.109:11434

# Pool URLs — JSON array. When set, takes precedence over the singular
# OLLAMA_*_BASE_URL above. The OllamaPool client load-balances across all
# listed instances using least-in-flight + round-robin tie-break.
#OLLAMA_LLM_BASE_URLS='["http://10.0.1.121:11434","http://10.0.1.109:11434"]'
#OLLAMA_VLM_BASE_URLS='["http://10.0.1.121:11434","http://10.0.1.109:11434"]'
#OLLAMA_EMBEDDING_BASE_URLS='["http://10.0.1.122:11434"]'

# Per-function pools — JSON array. When set, override the role-level
# pool for that specific LLM function only. Cascade priority for each
# function: per-function plural > role-level plural > singular > base.
# Use this to route different functions to different Ollama banks
# (e.g. doc-analysis on a gpt-oss host, graph extraction on a gemma4 bank).
DOCLING_GRAPH_LLM_BASE_URLS='["http://10.0.1.121:11434","http://10.0.1.109:11434"]'
DOC_ANALYSIS_LLM_BASE_URLS='["http://10.0.1.121:11434","http://10.0.1.109:11434"]'
TRANSLATION_LLM_BASE_URLS='["http://10.0.1.121:11434","http://10.0.1.109:11434"]'
COMMUNITY_REPORT_LLM_BASE_URLS='["http://10.0.1.121:11434","http://10.0.1.109:11434"]'
PICTURE_DESCRIPTION_BASE_URLS='["http://10.0.1.121:11434","http://10.0.1.109:11434"]'
OLLAMA_NUM_CTX=64000
# LLM max output tokens. Must fit within the model's output ceiling:
#   llama3.3:70b — 32000+  (current default)
#   llama3.1:8b  — 4092
#   gpt-oss:120b — >> 64000
LLM_MAX_TOKENS=64000

# ---------------------------------------------------------------------------
# Document Analysis (LLM metadata extraction after Docling conversion)
# ---------------------------------------------------------------------------
DOC_ANALYSIS_ENABLED=true
DOC_ANALYSIS_LLM_MODEL=gemma4:31b
DOC_ANALYSIS_LLM_THINK=true
DOC_ANALYSIS_TIMEOUT=1500
# Celery soft/hard limits for derive_document_metadata (new explicit fields;
# previously derived from DOC_ANALYSIS_TIMEOUT+60/+120 in pipeline.py).
DOC_ANALYSIS_SOFT_TIME_LIMIT=1800
DOC_ANALYSIS_TIME_LIMIT=2400
DOC_ANALYSIS_SUMMARY_PROMPT="Summarize this document in 5-6 sentences for a technical reader. Focus on the main subject, scope, and notable findings. Do not include source endnote markings such as [1]."
DOC_ANALYSIS_DATE_PROMPT="Extract the most relevant date of information (publication date, report date, or coverage window). If only month/year appears, return that. If there is a range, return it exactly. If unsure, return Unknown. Provide ONLY the date or range."
DOC_ANALYSIS_SOURCE_PROMPT="Characterize the source: 1) Organization or author (if unknown return UNKNOWN) 2) Type of information (website, journal, etc; if unknown return UNKNOWN) 3) Reliability score 1-10. Format: Organization: <name>\nType: <type>\nReliability: <score>/10"
DOC_ANALYSIS_CLASSIFICATION_PROMPT="Identify the document classification marking if present (UNCLASSIFIED, CUI, FOUO, SECRET, TOP SECRET). If none, reply UNCLASSIFIED. Provide ONLY the marking."

# ---------------------------------------------------------------------------
# Picture Description (post-conversion via Ollama, uses document summary as context)
# ---------------------------------------------------------------------------
PICTURE_DESCRIPTION_MODEL=gemma4:31b
PICTURE_DESCRIPTION_THINK=false
PICTURE_DESCRIPTION_TIMEOUT=17400
PICTURE_DESC_MAX_RETRIES=1
PICTURE_DESC_RETRY_DELAY=300
PICTURE_DESC_SOFT_TIME_LIMIT=18000
PICTURE_DESC_TIME_LIMIT=21600
# Max concurrent VLM calls per document. Cap at OLLAMA_NUM_PARALLEL on the model server.
PICTURE_DESC_CONCURRENCY=5
# Stale stage_run sweeper threshold (seconds). Rows at RUNNING older than this
# get marked FAILED by periodic_stale_run_sweep.
STALE_STAGE_RUN_THRESHOLD_SECONDS=34200
# (PICTURE_DESCRIPTION_PROMPT — long; see .env for full text)
PICTURE_DESCRIPTION_PROMPT="Describe the image."

# ---------------------------------------------------------------------------
# Translation (foreign language detection + LLM translation)
# ---------------------------------------------------------------------------
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=gemma4:31b
TRANSLATION_THINK=false
TRANSLATION_TIMEOUT=180
TRANSLATION_MIN_DETECT_LENGTH=5
TRANSLATION_SOFT_TIME_LIMIT=7200
TRANSLATION_TIME_LIMIT=8100
# (TRANSLATION_PROMPT — long; see .env for full text)
TRANSLATION_PROMPT="Translate ALL non-English text to English."

# ---------------------------------------------------------------------------
# Docling OCR & document conversion service
# ---------------------------------------------------------------------------
DOCLING_OCR_LANG=en
DOCLING_SERVICE_URL=http://docling:8001
DOCLING_TIMEOUT_SECONDS=3300
DOCLING_FALLBACK_ENABLED=false
DOCLING_DEVICE=cuda
DOCLING_DTYPE=bfloat16
DOCLING_PORT=8001

# ---------------------------------------------------------------------------
# Docling-Graph Service — Pass B (chunked + sent to LLM for graph extraction)
# ---------------------------------------------------------------------------
DOCLING_GRAPH_LLM_PROVIDER=ollama
DOCLING_GRAPH_LLM_MODEL=gemma4:31b
DOCLING_GRAPH_LLM_TEMPERATURE=1.0
DOCLING_GRAPH_LLM_THINK=false #false|true, low|medium|high
DOCLING_GRAPH_FORCE_JSON_MODE=true
# Override LiteLLM's default 4092 ceiling for ollama/* models that aren't in
# its metadata registry. Must be >= LLM_MAX_TOKENS for the library to accept
# max_tokens. 131072 = llama3.3:70b's total context.
DOCLING_GRAPH_LLM_MAX_OUTPUT_TOKENS=65536
DOCLING_GRAPH_LLM_CONTEXT_LIMIT=131072
# Chunker + batcher token budgets (config_builder.py defaults are 512 / 1024).
# Bumped to keep large spec tables (e.g., SA-2 missile spec) atomic in a single
# chunk and group more chunks per LLM call. Avoids HybridChunker's per-row
# splitting that loses in-table section headers (1st Stage / 2nd Stage / etc.).
# Trade-off: bigger LLM prompts per call, fewer total calls. Stays well below
# DOCLING_GRAPH_LLM_CONTEXT_LIMIT=131072.
DOCLING_GRAPH_CHUNK_MAX_TOKENS=512
DOCLING_GRAPH_LLM_BATCH_TOKEN_SIZE=512
# Per-pass override for system_links specifically — that pass needs MORE
# context per LLM call (many entities visible together) to do cross-system
# inference. Quadrupling these for system_links keeps other passes lean.
DOCLING_GRAPH_SYSTEM_LINKS_CHUNK_MAX_TOKENS=4096
DOCLING_GRAPH_SYSTEM_LINKS_LLM_BATCH_TOKEN_SIZE=4096
# Output-token caps for the LLM. Initial cap is 32768 for merged-mode (Phase
# 1, bundle air_defense_v3_merged_v1): merged chunks are ~5x larger than
# per-element so the LLM produces proportionally more output. 16384 was the
# legacy per-element value; 65536 retry still kicks in for outlier batches.
DOCLING_GRAPH_LLM_MAX_TOKENS=32768
DOCLING_GRAPH_LLM_TRUNCATION_RETRY_MAX_TOKENS=65536
# Blanks ad-tracking URLs / nav-list / standalone-link text elements in the
# DoclingDocument before /extract-pass chunks it. Element kept in place;
# only `text`/`orig` content cleared so $refs and hierarchy stay valid.
# Image captions (label='caption') are always preserved. Set to false to
# debug whether sanitize is masking real content.
DOCLING_GRAPH_SANITIZE_INPUT=true
# Per-call HTTP timeout (worker → docling-graph). Each /extract-pass fans
# out to many small LLM calls inside docling-graph, so wall-time scales
# with doc size. 72000s (20h) accommodates field-rich passes on 90+ page
# parameter-heavy PDFs where schema-grammar constrained decoding on
# gemma4:31b can run multi-hour per pass.
DOCLING_GRAPH_LLM_TIMEOUT=720000
# Delta quality gate: temporarily lowered to 1 while debugging sparse prose
# extractions. Default in config_builder.py is 3; upstream library default
# is 20. Raise back once we confirm non-empty extractions on prose docs.
DOCLING_GRAPH_QUALITY_MIN_INSTANCES=1
DOCLING_GRAPH_BACKEND=llm
DOCLING_GRAPH_PORT=8002
# Mechanism A1 kill switch: when "false", parser-side
# extract_table_overlay() is skipped and the worker-side
# is_overlay_enabled_worker() short-circuits both Phase 0 (alias rewrite)
# and Phase 0.5 (field overlay), even when cached overlays exist on
# pipeline_pass_outputs.metadata_json. Worker-side check is AUTHORITATIVE
# (spec §4.3).
DOCLING_GRAPH_TABLE_OVERLAY_ENABLED=true
DOCLING_GRAPH_BASE_URL=http://docling-graph:8002
# docling-graph extraction semaphore (asyncio.Semaphore in main.py:166).
# Caps concurrent /extract-pass requests inside the docling-graph service.
# Match to PASS_CONCURRENCY_PER_DOCUMENT so the worker fan-out isn't
# bottlenecked at the parser.
DOCLING_GRAPH_MAX_CONCURRENT_EXTRACTIONS=2
DOCLING_GRAPH_TIMEOUT=720000
# Parallel chunk batches per /extract-pass (client-side fan-out to Ollama).
# Effective parallelism is min(this, OLLAMA_NUM_PARALLEL on the LLM host).
# Match this to the LLM host's OLLAMA_NUM_PARALLEL — anything higher just
# queues client-side.
DOCLING_GRAPH_PARALLEL_WORKERS=4
# Optional process-wide cap on outbound Ollama chat generations from the
# docling-graph service. Set to the fixed slot budget when PARALLEL_WORKERS is
# intentionally higher than backend capacity, so long-tail passes can reuse
# idle slots without oversubscribing Ollama.
DOCLING_GRAPH_LLM_MAX_IN_FLIGHT=0
# Per-batch hard timeout (seconds) used by the BATCH_HARD_TIMEOUT watchdog
# patch (docker/docling-graph/patches/0001-orchestrator-batch-hard-timeout.patch).
# Fires a loud-ERROR `Warning: BATCH_HARD_TIMEOUT` if any batch ThreadPoolExecutor
# future hangs longer than this. Tripled from the patch default of 3600s (1h)
# to 10800s (3h) on 2026-05-15 — second-tier 65K truncation retries on
# kinematics/identity passes can take 20+ min and the 1h ceiling started
# soft-failing batches that would have eventually completed.
DOCLING_GRAPH_BATCH_HARD_TIMEOUT_SECONDS=10800

# Graph extraction chunking
GRAPH_EXTRACTION_CHUNK_SIZE=100000
GRAPH_EXTRACTION_CHUNK_OVERLAP=2000

# Graph extraction confidence
DOCLING_REVIEW_CONFIDENCE_THRESHOLD=0.60

# Graph confidence quality gates
GRAPH_NODE_MIN_CONFIDENCE=0.60
GRAPH_REL_MIN_CONFIDENCE=0.55
GRAPH_REJECT_INVALID_RELATIONSHIPS=false

# Default ontology bundle (used when neither caller nor source overrides)
DEFAULT_ONTOLOGY_BUNDLE_KEY=air_defense_v3

# Per-pass retry budget
PASS_MAX_RETRIES=3

# Per-pass Celery task configuration (per-pass fan-in architecture).
# Soft time limit per individual derive_ontology_graph_pass task (seconds).
# SoftTimeLimitExceeded fires at this threshold; pass-level retries kick in.
# 80h — sized so very large docs (e.g. 29MB / 174-batch radar PDFs) whose
# passes run for hours under pool contention are not killed mid-pass. Must
# stay below CELERY_VISIBILITY_TIMEOUT to avoid broker redelivery double-runs.
PASS_SOFT_TIME_LIMIT=288000

# Per-document dispatcher fan-out cap. The outer derive_ontology_graph
# dispatcher fans out at most this many entity passes simultaneously per
# document; further passes dispatch on completion callbacks. Must be >=
# WORKER_GRAPH_CONCURRENCY for Celery slots to actually be used.
PASS_CONCURRENCY_PER_DOCUMENT=2

# Stale phase reclaim threshold (seconds). A dispatched_phases row stuck in
# 'claimed' or 'dispatched' longer than this is eligible for reclaim by
# reconcile_ontology_graph_runs (per-pass-fanin safety net).
PHASE_CLAIM_STALE_SECONDS=30

# Reconciler beat period (seconds). Celery beat schedules
# reconcile_ontology_graph_runs at this interval to detect stuck phases.
RECONCILER_PERIOD_SECONDS=60

# ---------------------------------------------------------------------------
# ArcadeDB — multi-model graph + vector database
# ---------------------------------------------------------------------------
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=eip_arcadedb_secret
ARCADEDB_DATABASE=eip_knowledge_graph
ARCADEDB_HTTP_PORT=2480
ARCADEDB_GRPC_PORT=2424
ARCADEDB_ROOT_PASSWORD=eip_arcadedb_secret
ARCADEDB_READY_CACHE_SECONDS=600.0
ARCADEDB_SLOW_QUERY_THRESHOLD_SECONDS=10.0
# efSearch: higher = better recall, slower. 0 = adaptive default.
ARCADEDB_VECTOR_EF_SEARCH=0

# ---------------------------------------------------------------------------
# Community Detection
# ---------------------------------------------------------------------------
COMMUNITY_DETECTION_ENABLED=true
COMMUNITY_DETECTION_INTERVAL_MINUTES=600
COMMUNITY_DETECTION_POST_INGEST_ENABLED=true
COMMUNITY_DETECTION_POST_INGEST_THRESHOLD=5
COMMUNITY_DETECTION_ALGORITHM=louvain
COMMUNITY_DETECTION_RESOLUTION=1.0
COMMUNITY_DETECTION_MAX_ITERATIONS=20
COMMUNITY_REPORT_LLM_MODEL=gemma4:31b
COMMUNITY_REPORT_LLM_THINK=true
# (COMMUNITY_REPORT_LLM_PROMPT — long analyst prompt; see .env for full text)
COMMUNITY_REPORT_LLM_PROMPT="Summarize this graph community as a JSON object."
# (COMMUNITY_GLOBAL_SYNTHESIS_PROMPT — long synthesis prompt; see .env for full text)
COMMUNITY_GLOBAL_SYNTHESIS_PROMPT="Synthesize an answer from these community reports."

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2

# Split worker concurrency (used with docker compose --profile split)
WORKER_INGEST_CONCURRENCY=3
WORKER_EMBED_CONCURRENCY=2
WORKER_GRAPH_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Pipeline retry & time-limit settings
# ---------------------------------------------------------------------------
PREPARE_MAX_RETRIES=10
PREPARE_RETRY_DELAY=1200
PREPARE_SOFT_TIME_LIMIT=3600
PREPARE_TIME_LIMIT=4500

EMBED_MAX_RETRIES=10
EMBED_RETRY_DELAY=1200
EMBED_SOFT_TIME_LIMIT=3600
EMBED_TIME_LIMIT=4500

GRAPH_MAX_RETRIES=25
GRAPH_RETRY_DELAY=1200
GRAPH_SOFT_TIME_LIMIT=288000
GRAPH_TIME_LIMIT=324000

FINALIZE_MAX_RETRIES=10
FINALIZE_RETRY_DELAY=1200
FINALIZE_SOFT_TIME_LIMIT=600
FINALIZE_TIME_LIMIT=900

# Max chain-level sweeper retries per doc. Beyond this, the doc is permanently
# FAILED for operator triage.
MAX_DOC_RETRY_COUNT=3

# Docling concurrency & health
DOCLING_CONCURRENCY=3
DOCLING_LOCK_TIMEOUT=3600
DOCLING_HEALTH_TIMEOUT=15.0
DOCLING_503_MAX_RETRIES=20

# Singleflight lock timeout for prepare_document (seconds)
PREPARE_SINGLEFLIGHT_TIMEOUT=4200

# ---------------------------------------------------------------------------
# Retrieval Scoring — Weighted Fusion
# ---------------------------------------------------------------------------
QUERY_DEFAULT_TOP_K=20
QUERY_DEFAULT_MIN_CONFIDENCE=0.1

RETRIEVAL_SEMANTIC_WEIGHT=0.65
RETRIEVAL_DOC_STRUCTURE_WEIGHT=0.20
RETRIEVAL_ONTOLOGY_WEIGHT=0.15

# Retrieval diversity (content-level dedup)
RETRIEVAL_DIVERSITY_OVERSAMPLE_FACTOR=8
RETRIEVAL_DIVERSITY_MAX_CANDIDATES=800

# Document-structure link weights
RETRIEVAL_WEIGHT_NEXT_CHUNK=0.90
RETRIEVAL_WEIGHT_SAME_SECTION=0.88
RETRIEVAL_WEIGHT_SAME_ARTIFACT=0.82
RETRIEVAL_WEIGHT_SAME_PAGE=0.78

# Expansion limits
RETRIEVAL_DOC_EXPAND_K=5
RETRIEVAL_DOC_MAX_HOPS=2
RETRIEVAL_ONTOLOGY_EXPAND_K=5

# Hop penalty and bonuses
RETRIEVAL_HOP_PENALTY_BASE=0.92
RETRIEVAL_MIL_ID_BONUS=0.03

# Legacy decay (fallback for pre-v2 documents without chunk_links)
RETRIEVAL_CROSS_MODAL_DECAY=0.85
RETRIEVAL_ONTOLOGY_DECAY=0.75

# ---------------------------------------------------------------------------
# Reranker (cross-encoder for retrieval re-scoring)
# ---------------------------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_TOP_N=20

# Minimum cosine similarity for results
RETRIEVAL_MIN_SCORE_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# Governance / Security
# ---------------------------------------------------------------------------
GOVERNANCE_DUAL_APPROVAL_REQUIRED=false
DEFAULT_CLASSIFICATION=UNCLASSIFIED

# ---------------------------------------------------------------------------
# Directory watcher
# ---------------------------------------------------------------------------
WATCH_DIR_POLL_INTERVAL_SECONDS=120

# ---------------------------------------------------------------------------
# Table normalization (spec 2026-05-11)
# ---------------------------------------------------------------------------
# Graph-side master switch. Default false ships code without changing behavior; flip to true to activate per-entity-column chunks for the LLM.
DOCLING_GRAPH_TABLE_NORMALIZATION_ENABLED=false
# Experimental: re-enable the reverted _table_facts.py path (mutually exclusive with normalization). For A/B comparison only.
DOCLING_GRAPH_USE_EXPERIMENTAL_TABLE_FACTS=false
# When graph normalization is on, strip the raw flattened table text from texts[] so the LLM sees only normalized chunks.
DOCLING_GRAPH_SUPPRESS_RAW_TABLE_MARKDOWN=true
# Token threshold; tables whose whole rendering is <= this emit one TABLE_WHOLE chunk; above, per-entity-column.
DOCLING_GRAPH_TABLE_WHOLE_LIMIT=512
# Per-column rendering above this size splits by section, repeating the identity header.
DOCLING_GRAPH_TABLE_COLUMN_LIMIT=512
# Per-pass overrides for system_links (see chunker comment above) — same
# 4096 ladder. Invariants checked at docling-graph startup.
DOCLING_GRAPH_SYSTEM_LINKS_TABLE_WHOLE_LIMIT=4096
DOCLING_GRAPH_SYSTEM_LINKS_TABLE_COLUMN_LIMIT=4096
# Embedding-side master switch. Default false ships code without changing behavior.
EMBEDDING_TABLE_NORMALIZATION_ENABLED=false
# Cap on the always-emitted TABLE_SUMMARY chunk size (bge-m3 tokens).
EMBEDDING_TABLE_SUMMARY_MAX_TOKENS=300
# Minimum bge-m3 token count for a normalized table to be substituted in the chunker; below this, native chunk passes through unchanged.
MIN_TABLE_NORMALIZATION_TOKENS=256

# ---------------------------------------------------------------------------
# VR (Vector Router) mode
# ---------------------------------------------------------------------------
# disabled:    router never invoked; legacy full-doc dispatch
# shadow:      router invoked + diagnostics persisted; worker ALWAYS dispatches
#              RUN_FULL (no narrowing). Safe rollout default.
# narrow_only: worker narrows on mode=selected_refs; fails open to RUN_FULL on
#              mode=would_skip with fail_open_reason captured.
# (skip_enforce is DEFERRED — not exposed)
VECTOR_ROUTER_MODE=shadow
# Internal API base URL used by worker to call /v1/extraction/chunk-scope.
# Default: api container in docker-compose. Override for local dev/testing.
INTERNAL_API_BASE_URL=http://api:8000
# Timeout (seconds) for the /v1/extraction/chunk-scope HTTP call (default: 10.0).
VECTOR_ROUTER_CHUNK_SCOPE_TIMEOUT_S=600.0
# VR retrieval mode — 'hnsw' (legacy global-graph + post-filter) or 'direct'
# (per-run SQL pull + numpy cosine; no HNSW post-filter starvation).
# Default: 'direct' as of 2026-05-26 after Path B implementation + Codex
# review + live smoke. Revert to 'hnsw' here or revert the default-flip
# commit in app/config.py if regressions surface.
VECTOR_ROUTER_RETRIEVAL_MODE=direct

# ---------------------------------------------------------------------------
# Extraction index mode (merged-chunk routing)
# ---------------------------------------------------------------------------
# per_element: legacy — one ExtractionChunk row per docling element.
# merged:      one ExtractionChunk row per HybridChunker output chunk.
# 2026-05-28 Task 10.5: default flipped to 'merged' after Phase 1 partial-A/B
# evidence (Dvina missile_kinematics 1->2 ents, SA-2 radar_power_rf 22->24 ents,
# SA-2 missile_kinematics 16->28 ents). Bundle propagation lands the uniform
# merged-mode retrieval calibration (min_sim=0.35, top_n=50, top_k=15) across
# air_defense_v3 / _baseline_subset / _narrowing_v1 / _merged_v1.
# Evidence: docs/handoffs/2026-05-28-merged-mode-bundle-propagation.md
# Retirement clock for per_element starts 2026-05-28 (2-week window per
# 2026-05-27-merged-chunk-routing.md "Concrete backwards-compat removal trigger").
EXTRACTION_INDEX_MODE=merged

# Worker-only gate for upstream table normalization in
# build_extraction_index_hybrid (merged-mode index builder). When 'false',
# merged chunks keep their raw markdown tables (the LLM sees original
# column headers + values verbatim — better when pass schemas expect
# specific units the per-row renderer doesn't preserve). When 'true'
# (default), tables are normalized into per-row sentences at index time.
# Independent of DOCLING_GRAPH_TABLE_NORMALIZATION_ENABLED, which still
# governs the legacy per-pass path used by identity passes and per_element
# mode.
EXTRACTION_INDEX_UPSTREAM_TABLE_NORM=true

# Phase 2 kill-switch for the merged-mode selected-chunk handoff. When 'true'
# (default), narrow_only + merged mode forwards the router's verbatim merged
# chunks to docling-graph, which then BYPASSES docling-graph's own pass-aware
# sanitize + table-normalization + re-chunking (chunked mode). When 'false',
# the worker falls back to the scoped-document path (apply_chunk_scope over
# self_refs) so docling-graph runs its per-pass preprocessing — recovers recall
# on table-heavy docs (e.g. SA-2) at the cost of byte-identical index->LLM
# chunk parity. self_refs still narrow the scope either way.
WORKER_FORWARD_SELECTED_CHUNKS=true

# Phase-1 / Phase-1b offline (score,used) separation analysis
# (scripts/phase1_score_used_separation.py + scripts/phase1b_reweight_separator.py
# only — NOT read by any production code path; Phase-1b reuses these SAME vars
# and adds no new ones). Both are optional overrides with safe in-script defaults.
#   PHASE1_BUNDLE_KEY   — ontology bundle whose manifest + schemas supply the
#                         per-pass retrieval queries when recomputing scores.
#                         Default: air_defense_v3_merged_v1 (the shadow A0 bundle).
#   PHASE1_DATABASE_URL — override DSN for the read-only pipeline_pass_outputs
#                         query. Blank → reuse the app's settings.sync_database_url
#                         (correct in-container). Set to a host DSN when running
#                         the script outside the container, e.g.
#                         postgresql+psycopg2://eip:eip_secret@localhost:5437/eip
PHASE1_BUNDLE_KEY=air_defense_v3_merged_v1
PHASE1_DATABASE_URL=
