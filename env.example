# ============================================================
# EIP-MMDPP — Example Environment Configuration
# Copy this file to .env and customize for your deployment.
#
# Every variable referenced by app/config.py (Settings class) or
# docker-compose.yml is listed below with its code-default value and,
# where applicable, the valid options.
# ============================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                        # development | test | production
API_PORT=8000                              # Host port for FastAPI (container always binds 8000)
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL
SQL_ECHO=false                             # true = log every SQL statement (noisy)

# ---------------------------------------------------------------------------
# JWT / Auth
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256                        # HS256 | HS384 | HS512 | RS256 ...
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=300
JWT_REFRESH_TOKEN_EXPIRE_DAYS=70

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432                         # Host port; container always binds 5432
POSTGRES_DB=eip
POSTGRES_USER=eip
POSTGRES_PASSWORD=eip_secret

# Optional explicit overrides (leave blank to derive from POSTGRES_* above).
# docker-compose.yml overrides these for api/worker services to use in-network
# hostname `postgres` on port 5432 regardless of POSTGRES_PORT.
# DATABASE_URL=postgresql+asyncpg://eip:eip_secret@postgres:5432/eip
# DATABASE_URL_SYNC=postgresql+psycopg2://eip:eip_secret@postgres:5432/eip
DATABASE_URL=
DATABASE_URL_SYNC=

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_PORT=6379                            # Host port; container always binds 6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Celery Redis visibility timeout (seconds) — prevents redelivery of long tasks
CELERY_VISIBILITY_TIMEOUT=36000

# ---------------------------------------------------------------------------
# MinIO / Object Storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false                         # true for TLS
MINIO_BUCKET_RAW=eip-raw
MINIO_BUCKET_DERIVED=eip-derived
MINIO_API_PORT=9010                        # Host port for MinIO API (avoid conflicts)
MINIO_CONSOLE_PORT=9011                    # Host port for MinIO web console

# ---------------------------------------------------------------------------
# Text embedding (Ollama or HuggingFace model)
# ---------------------------------------------------------------------------
TEXT_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
TEXT_EMBEDDING_DIM=1024
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_TOKENIZER_MODEL=BAAI/bge-m3          # HuggingFace repo for HybridChunker tokenizer
EMBED_TEXT_BATCH_SIZE=128

# ---------------------------------------------------------------------------
# Image embedding (OpenCLIP)
# Options:
#   ViT-B-32                   / openai               / 512   (~400MB, baseline)
#   ViT-B-16                   / openai               / 512   (~600MB, minor quality bump)
#   ViT-L-14                   / laion2b_s32b_b82k    / 768   (~1.7GB, good quality/size ratio)
#   EVA02-E-14-plus            / laion2b_s9b_b144k    / 1024  (~4.4GB, best quality, large GPU)
#   ViT-SO400M-16-SigLIP2-384  / webli                / 1152  (~1.8GB, best modern drop-in)
# NOTE: Changing dim requires ArcadeDB vector index recreation + reingest.
# ---------------------------------------------------------------------------
IMAGE_EMBEDDING_MODEL=ViT-L-16-SigLIP2-256
IMAGE_EMBEDDING_PRETRAINED=webli
IMAGE_EMBEDDING_DIM=1024
HF_TOKEN=                                  # HuggingFace token for gated models

# ---------------------------------------------------------------------------
# LLM Provider — system-wide (applies to ALL LLM features)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama                        # ollama | openai | mock

# OpenAI (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=                            # Required when LLM_PROVIDER=openai
OPENAI_BASE_URL=                           # Leave empty for default; set for OpenAI-compatible endpoints

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434        # Fallback when neither plural-pool nor singular-URL forms below are set

# Recommended (canonical): JSON-array pools — load-balance across multiple
# Ollama instances using least-in-flight routing. When set, these take
# precedence over the singular OLLAMA_*_BASE_URL forms below.
# Example with 2 hosts: ["http://10.0.1.121:11434","http://10.0.1.122:11434"]
OLLAMA_LLM_BASE_URLS=                      # Chat/reasoning pool: doc analysis, translation, community reports, global query
OLLAMA_VLM_BASE_URLS=                      # Vision/multimodal pool: picture description (gemma3, llava, etc.)
OLLAMA_EMBEDDING_BASE_URLS=                # Embedding pool: BGE text embeddings

# Per-function URL pools (NEW). When set, override the role-level
# OLLAMA_*_BASE_URLS above for that specific function. Use this to route
# different LLM functions to different banks of Ollama instances — e.g.
# doc analysis on a gpt-oss:120b host, graph extraction on a gemma4:31b
# bank, translation on a llama3.3:70b host.
# Format: JSON array of base URLs.
# Example: ["http://10.0.1.121:11434","http://10.0.1.122:11434"]
DOCLING_GRAPH_LLM_BASE_URLS=
DOC_ANALYSIS_LLM_BASE_URLS=
TRANSLATION_LLM_BASE_URLS=
COMMUNITY_REPORT_LLM_BASE_URLS=
PICTURE_DESCRIPTION_BASE_URLS=
TEXT_EMBEDDING_BASE_URLS=

# Legacy fallbacks (singular). Kept for back-compat with older .env files;
# uncomment to use a single Ollama URL per role when the plural pool above
# is left blank. Both forms are accepted — plural pools take precedence.
# OLLAMA_LLM_BASE_URL=http://10.0.1.121:11434
# OLLAMA_VLM_BASE_URL=http://ollama:11434
# OLLAMA_EMBEDDING_BASE_URL=http://ollama:11434
OLLAMA_LLM_BASE_URL=
OLLAMA_VLM_BASE_URL=
OLLAMA_EMBEDDING_BASE_URL=

OLLAMA_NUM_CTX=16384                       # Context window size for Ollama models
LLM_MAX_TOKENS=64000                       # Max output tokens; thinking models need high values

# ---------------------------------------------------------------------------
# Document Analysis (LLM metadata extraction after Docling conversion)
# ---------------------------------------------------------------------------
DOC_ANALYSIS_ENABLED=true
DOC_ANALYSIS_LLM_MODEL=llama3.3:70b
DOC_ANALYSIS_LLM_THINK=                    # true | false for most Ollama models; low | medium | high only for gpt-oss
DOC_ANALYSIS_TIMEOUT=1500                  # HTTP client timeout for individual LLM calls (Celery limit is now a separate field)
DOC_ANALYSIS_SUMMARY_PROMPT="Summarize this document in 3-5 sentences for a technical reader. Focus on the main subject, scope, and notable findings. Do not include source endnote markings such as [1]."
DOC_ANALYSIS_DATE_PROMPT="Extract the most relevant date of information (publication date, report date, or coverage window). If only month/year appears, return that. If there is a range, return it exactly. If unsure, return Unknown. Provide ONLY the date or range."
DOC_ANALYSIS_SOURCE_PROMPT="Characterize the source: 1) Organization or author (if unknown return UNKNOWN) 2) Type of information (website, journal, etc; if unknown return UNKNOWN) 3) Reliability score 1-10. Format: Organization: <name>\nType: <type>\nReliability: <score>/10"
DOC_ANALYSIS_CLASSIFICATION_PROMPT="Identify the document classification marking if present (UNCLASSIFIED, CUI, FOUO, SECRET, TOP SECRET). If none, reply UNCLASSIFIED. Provide ONLY the marking."

# ---------------------------------------------------------------------------
# Picture Description (post-conversion VLM via Ollama)
# ---------------------------------------------------------------------------
PICTURE_DESCRIPTION_MODEL=gemma4:26b
PICTURE_DESCRIPTION_THINK=                 # true | false for most Ollama models; low | medium | high only for gpt-oss
PICTURE_DESCRIPTION_TIMEOUT=17400
PICTURE_DESC_MAX_RETRIES=1
PICTURE_DESC_RETRY_DELAY=300
PICTURE_DESC_SOFT_TIME_LIMIT=18000
PICTURE_DESC_TIME_LIMIT=21600
# Max concurrent VLM calls per document. Cap at OLLAMA_NUM_PARALLEL on the model server.
PICTURE_DESC_CONCURRENCY=5
# Stale stage_run sweeper threshold (seconds). Rows at RUNNING older than this
# get marked FAILED by periodic_stale_run_sweep.
STALE_STAGE_RUN_THRESHOLD_SECONDS=34200
PICTURE_DESCRIPTION_PROMPT="You are a senior scientific and technical intelligence analyst specializing in missiles, air and missile defense, radars, launchers, fire-control systems, RF/sensor payloads, guidance and control, telemetry, flight test instrumentation, and support equipment.\n\nAnalyze one image from a multimodal PDF for intelligence exploitation, prioritizing physical characteristics first.\n\nSource Rule: Use the PDF Summary only for context. Base judgments on visible image evidence. If the summary conflicts with the image, note it and prioritize the image.\n\nTask: Classify the image as exactly one of: docs_handwritten, engineering_drawing, block_diagram, raw_signal_data, charts_graphs, photo, then produce a concise but complete exploitation report.\n\nRules:\n\nPrioritize: (1) physical characteristics, (2) technical characteristics, (3) performance indicators, (4) function/role/identity, (5) confidence/caveats.\nAlways complete the analysis, even at low confidence.\nDo not guess unreadable, obscured, or ambiguous details; put them in Uncertainty.\nDistinguish direct observation, context-informed assessment, reasoned inference, and low-confidence speculation.\nDo not invent markings, dimensions, capabilities, or identities.\nIf identification is uncertain, give the most likely possibilities and visual basis.\nUse precise defense/intelligence language, SI units where applicable, sensible numeric precision, and verbatim OCR when possible.\nIf foreign-language text is visible, transcribe and translate it, marking uncertainty clearly.\nDo not identify people; only count faces if present.\nChoose 1 winning category and give 2 alternates with rationale.\nFill only the matching category subsection.\n\nOutput format:\n\n1) Classification\nCategory=<one category>; Confidence (0-1)=<value>; Alternates=<top 2 alternates with brief rationale>\n\n2) Why This Category (Evidence)\nExplain the classification using visible cues.\n\n3) General Description\nWrite 1-2 concise sentences describing the image, emphasizing visible physical form, layout, geometry, components, and configuration before function or identity.\n\n4) OCR\nHas Text=yes/no; Legibility=good|medium|poor; Verbatim Text=<short exact text, or (none)>; Translation=<English translation of foreign-language text, or (none)>\n\n5) Category-Specific Details\nFill only the matching subsection:\n\ndocs_handwritten: Document Type; Key Fields/Headings; Dates/Times; Units/Notations; Entities/Identifiers; Signatures/Initials; Language; Remarks\nengineering_drawing: Title/Drawing No./Rev; Scale & Units; Projection; Dimensions & Tolerances; Materials/Finish/Notes; Title Block Highlights; Subsystem Relevance\nblock_diagram: Main Blocks; Signal/Control Paths; I/O; Hierarchy; Acronyms; Function Summary\nraw_signal_data: Display Type; Freq/Band; Timebase/Span; Vertical/Amplitude Scale; Measured Values; Channels/Overlays; Instrument/Model; Observations\ncharts_graphs: Chart Type; Title & Axes; Series & Legend; Example Points; Trends/Extrema; Domain Relevance\nphoto: Scene; Primary Subjects; Objects/Features (top 5); Text in Scene (no PII); Faces=count only; Safety/PPE; Context Cues\n\nInclude relevant physical and technical cues such as shape, dimensions, layout, fins, control surfaces, launcher form, antenna geometry, cabling, cooling, instrumentation, support vehicles, chassis, outriggers, and deployment features.\n\n6) Extracted Technical Takeaways\nProvide 3-4 concise bullets, starting with the most important physical observations, then supported technical or performance-relevant insights.\n\n7) Uncertainty\nNote unreadable regions, occlusions, low resolution, angle limits, ambiguous symbols, incomplete scale, hidden components, uncertain translation, and any mismatch with the PDF Summary.\n\n8) Analyst Notes\nWrite 3-4 concise sentences on summary influence, consistency with the image, key caveats, intelligence significance, and next best analytical step.\n\nInputs:\n\nPDF Summary: {document_summary}\nImage: [insert image here]"

# ---------------------------------------------------------------------------
# Translation (foreign language detection + LLM translation)
# ---------------------------------------------------------------------------
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=llama3.3:70b
TRANSLATION_THINK=                         # true | false for most Ollama models; low | medium | high only for gpt-oss
TRANSLATION_TIMEOUT=180
TRANSLATION_MIN_DETECT_LENGTH=5            # Min chars before language detection runs
TRANSLATION_SOFT_TIME_LIMIT=7200
TRANSLATION_TIME_LIMIT=8100
TRANSLATION_PROMPT="Translate ALL non-English text to English. The input may contain a mix of English and non-English text — translate every non-English word or phrase to English while keeping English portions unchanged. Do NOT skip non-English text even if it appears alongside English. Preserve all markdown formatting including headings (#), bullet points, tables, and code blocks. Keep technical designators like model numbers (С-75, 9М38) in their original form, but translate descriptive words around them (e.g., 'Зенитный Ракетный Комплекс С-75' → 'Anti-aircraft Missile System С-75'). Preserve all numbers, units, and acronyms. Preserve ---ELEMENT_BOUNDARY--- markers exactly as they appear. Return only the translated text with no commentary."

# ---------------------------------------------------------------------------
# Docling — document conversion service (granite-docling-258M VLM)
# ---------------------------------------------------------------------------
DOCLING_OCR_LANG=en
DOCLING_SERVICE_URL=http://docling:8001
DOCLING_TIMEOUT_SECONDS=3300
DOCLING_FALLBACK_ENABLED=false             # true = fall back to legacy extraction if Docling is down
DOCLING_DEVICE=cuda                        # cuda | cpu
DOCLING_DTYPE=bfloat16                     # bfloat16 | float32 (use float32 for CPU)
DOCLING_PORT=8001

# ---------------------------------------------------------------------------
# Docling-Graph Service — bundle-based entity/relationship extraction
# ---------------------------------------------------------------------------
DOCLING_GRAPH_LLM_PROVIDER=ollama          # ollama | openai
DOCLING_GRAPH_LLM_MODEL=llama3.3:70b
DOCLING_GRAPH_LLM_THINK=false              # true | false for most Ollama models; low | medium | high only for gpt-oss
DOCLING_GRAPH_FORCE_JSON_MODE=false        # true → always use Ollama format="json" (loose). Required for models <=30B like gemma4:26b where schema-grammar constraint produces unterminated-string JSON parse errors. Pydantic validates downstream, so schema safety isn't relaxed.
DOCLING_GRAPH_SANITIZE_INPUT=true          # true → blank web-cruft texts (ad-tracking URLs, nav-list links, standalone bare URLs) before chunking; image captions (label='caption') are always preserved. Element stays in place with empty content so $refs and hierarchy stay valid. Set false to disable for debugging whether sanitize is masking real content.
DOCLING_GRAPH_LLM_TIMEOUT=72000            # Per-call HTTP timeout (worker → docling-graph), seconds. Each /extract-pass fans out to many small LLM calls; total wall-time scales with doc size. 72000s (20h) accommodates field-rich passes on 90+ page PDFs where schema-grammar constrained decoding can run multi-hour per pass on mid-size models.
DOCLING_GRAPH_BACKEND=llm                  # llm | vlm (vlm requires GPU; enable deploy block in compose)
DOCLING_GRAPH_PORT=8002
DOCLING_GRAPH_BASE_URL=http://docling-graph:8002
DOCLING_GRAPH_CONCURRENCY=2
DOCLING_GRAPH_TIMEOUT=72000
DOCLING_GRAPH_PARALLEL_WORKERS=1           # Concurrent chunk batches per /extract-pass. **DEFAULT 1 (was 3)** — eliminates a silent deadlock class in the vendored library's parallel-batch dispatcher (orchestrator.py:518: `as_completed(futures)` with no timeout, ThreadPoolExecutor.__exit__ → shutdown(wait=True) blocks on hung futures, freezes pass with zero log output). Sequential mode (else-branch) is well-behaved: each batch's 30-min httpx read-timeout fires loud, OllamaPool retries, all errors propagate. Re-enable >1 only after verifying the BATCH_HARD_TIMEOUT patch (docker/docling-graph/patches/0001-orchestrator-batch-hard-timeout.patch) catches the deadlock end-to-end.
DOCLING_GRAPH_BATCH_HARD_TIMEOUT_SECONDS=3600  # Defense-in-depth: per-batch ceiling for the parallel-dispatch as_completed loop. Only consulted when PARALLEL_WORKERS>1. Must be >= the OllamaPool client's read-timeout (1800s) so legitimate slow generations finish via httpx-level timeout (which surfaces as the existing failed_batches path) before this watchdog fires. When this fires, the patch logs `Warning: BATCH_HARD_TIMEOUT` to stdout, our wrapper promotes it to a `GRAPH_EXTRACTION_LIBRARY_WARNING tag=batch_hard_timeout` ERROR.

# Graph extraction chunking (chars). Most documents fit in one chunk;
# only very large documents (>100K chars) are chunked.
GRAPH_EXTRACTION_CHUNK_SIZE=100000
GRAPH_EXTRACTION_CHUNK_OVERLAP=2000

# Graph extraction confidence
DOCLING_REVIEW_CONFIDENCE_THRESHOLD=0.60

# Graph confidence quality gates (drop below threshold)
GRAPH_NODE_MIN_CONFIDENCE=0.60
GRAPH_REL_MIN_CONFIDENCE=0.55

# Validation-matrix enforcement:
#   true  = reject (raise) relationships whose (source, rel, target) triple
#           is not in the active ontology's validation_matrix
#   false = log and skip silently (default)
GRAPH_REJECT_INVALID_RELATIONSHIPS=false

# Default ontology bundle (used when neither caller nor Source overrides).
# Must exist under ontology_bundles/<key>/.
DEFAULT_ONTOLOGY_BUNDLE_KEY=air_defense_v3

# Per-pass retry budget. Default 3 = 1 initial call + 2 retries per pass.
PASS_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# ArcadeDB — multi-model graph + vector database
# ---------------------------------------------------------------------------
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=eip_arcadedb_secret
ARCADEDB_DATABASE=eip_knowledge_graph
ARCADEDB_HTTP_PORT=2480                    # Host port for ArcadeDB HTTP API
ARCADEDB_GRPC_PORT=2424                    # Host port for ArcadeDB gRPC
ARCADEDB_ROOT_PASSWORD=eip_arcadedb_secret # Server-side root password (used by JAVA_OPTS)

ARCADEDB_READY_CACHE_SECONDS=600.0         # How long to cache the /api/v1/ready result
ARCADEDB_SLOW_QUERY_THRESHOLD_SECONDS=10.0 # Queries longer than this are logged WARN

# efSearch controls vector search recall vs latency (ArcadeDB Manual §4.14.7).
# Higher = more accurate, slower. 0 = use ArcadeDB's adaptive default.
# Set explicitly for consistently high recall or strict latency.
ARCADEDB_VECTOR_EF_SEARCH=0

# ---------------------------------------------------------------------------
# Community Detection
# ---------------------------------------------------------------------------
COMMUNITY_DETECTION_ENABLED=true
COMMUNITY_DETECTION_INTERVAL_MINUTES=600
COMMUNITY_DETECTION_POST_INGEST_ENABLED=true
COMMUNITY_DETECTION_POST_INGEST_THRESHOLD=5
COMMUNITY_DETECTION_ALGORITHM=louvain      # leiden | louvain (leiden broken in ArcadeDB 26.5.x — null communityId)
COMMUNITY_DETECTION_RESOLUTION=1.0         # Higher = more, smaller communities
COMMUNITY_DETECTION_MAX_ITERATIONS=20
COMMUNITY_REPORT_LLM_MODEL=llama3.2
COMMUNITY_REPORT_LLM_THINK=                # true | false for most Ollama models; low | medium | high only for gpt-oss
COMMUNITY_REPORT_TIMEOUT=1500              # Per-call HTTP timeout for community-report + global-synthesis chats (seconds)

# Prompt overrides (domain-tuned for missile / air defense / RF / EW S&T).
# Leave empty to use the generic GraphRAG defaults baked into the service.
# COMMUNITY_REPORT_LLM_PROMPT must contain {entities} and {relationships}.
# COMMUNITY_GLOBAL_SYNTHESIS_PROMPT must contain {query} and {reports}.
COMMUNITY_REPORT_LLM_PROMPT="You are a senior all-source scientific and technical (S&T) intelligence analyst specializing in military missile systems, air and missile defense, radar and RF sensors, electronic warfare, and the associated fire-control, launcher, and C2 infrastructure that binds them. You will be given one graph-detected community — a cluster of related entities together with the relationships connecting them — extracted from multi-modal intelligence reporting.\n\nAnalytic rules:\n- Base every claim strictly on the provided entities and relationships. Do not invent systems, variants, unit affiliations, geolocations, performance figures, or capabilities that are not supported by the inputs.\n- Preserve alphanumeric and foreign-script designators VERBATIM (e.g., S-400, 9M96E2, 48Я6, 96Л6, AN/SPY-6(V)1, Type 346B, HQ-9B). Preserve Cyrillic, Chinese, and Arabic characters exactly as given.\n- Use SI units at <=3 significant figures unless the source specifies otherwise. Always include the unit (Hz, GHz, km, m, kg, kW, dBsm, kt).\n- Distinguish three epistemic levels for every non-trivial claim: Direct (stated in the inputs), Inferred (consistent with the inputs and standard doctrine), Speculative (possible but unsupported). Mark inline, e.g., '(Direct)', '(Inferred)', '(Speculative)'.\n- Use precise S&T vocabulary: radar band (L/S/C/X/Ku/Ka), waveform class (pulse-Doppler, FMCW, AESA monopulse), guidance mode (SARH, active RF, IIR, TVM, command+INS), engagement envelope (min/max range, altitude ceiling, target g-limit), launcher loadout, reload cycle, network link (TADIL-J, Link-16, Azart, ASN-4), and C2 echelon (battery / battalion / brigade / regimental / theater).\n- Do NOT identify named individuals and do NOT fabricate sources or dates.\n\nProduce ONE JSON object with exactly these two fields and nothing else:\n{\"title\": \"<=90 chars\", \"summary\": \"2-4 paragraphs of analyst-grade prose\"}\n\nTitle: concise and discriminative — name the dominant system, unit, sensor-shooter pairing, or functional theme (e.g., 'S-400 Battalion Engagement Chain: 96L6 + 92N6 → 48N6DM', 'X-band Naval Fire-Control Radar Tied to SAM Launchers', 'Mobile SHORAD Node: Pantsir-S1 + Barnaul-T C2').\n\nSummary: pack maximum intelligence value into 2-4 dense paragraphs, ordered:\n(1) What the community represents and the dominant mission area (area air defense, point defense, BMD, C-UAS, SEAD/DEAD target, counter-battery, EW/jamming, ISR, offensive strike, C2 integration).\n(2) The key entities and their analytically-important technical characteristics (frequency band, waveform, PRF where known, antenna type, emission footprint, guidance mode, seeker head, engagement envelope, launcher count, reload doctrine, command-link architecture, power/cooling signatures) — with each claim marked Direct/Inferred/Speculative.\n(3) The most intelligence-relevant relationships (supplier->recipient, unit<->equipment, subsystem<->system, co-located, engages, cues, slaved-to, command-subordinate, replaces/derived-from) and what they imply about capability, readiness, integration depth, or doctrinal role.\n(4) Intelligence gaps (missing designators, ambiguous variants, unknown production-run/PN, absent geolocation, unresolved unit identity, unknown date of information) and an overall Confidence rating — Low | Medium | High — with a one-sentence justification based on entity density, source diversity, and internal consistency.\n\nInputs:\n- Entities:\n{entities}\n\n- Relationships:\n{relationships}"
COMMUNITY_GLOBAL_SYNTHESIS_PROMPT="You are a senior all-source scientific and technical (S&T) intelligence analyst specializing in military missile systems, air and missile defense, radar and RF sensors, electronic warfare, and fire-control / C2 architecture. You will be given a user question and a ranked set of community reports — each report summarizes a graph-detected cluster of related entities with its own title and summary. Your job is to synthesize ONE comprehensive answer to the question using ONLY those reports.\n\nUser question:\n{query}\n\nCommunity reports (ranked by relevance, most-relevant first):\n{reports}\n\nAnalytic rules:\n- Base every claim strictly on the supplied community reports. Do not introduce systems, capabilities, unit identities, performance figures, or geolocations that are not present in the reports. If the reports are silent on a point the user asked about, say so explicitly.\n- When a report says something, cite it inline with its bracket tag, e.g., '[community 3]' or '[community 7, 12]'. Every non-trivial claim must carry at least one citation.\n- Preserve alphanumeric and foreign-script designators VERBATIM (S-400, 9M96E2, 48Я6, 96Л6, AN/SPY-6(V)1, Type 346B, HQ-9B — including Cyrillic, Chinese, and Arabic characters).\n- Use SI units at <=3 significant figures and always include the unit (Hz, GHz, km, m, kg, kW, dBsm, kt).\n- Preserve the Direct / Inferred / Speculative labels from the underlying reports when you quote their claims. If the reports disagree on designations or figures, call out the conflict and cite each side.\n- Do not identify named individuals. Do not fabricate dates, sources, or unit affiliations.\n- Use precise S&T vocabulary: radar band (L/S/C/X/Ku/Ka), waveform (pulse-Doppler, FMCW, AESA monopulse), guidance mode (SARH, active RF, IIR, TVM, command+INS), engagement envelope (min/max range, altitude ceiling, target g-limit), launcher loadout, network link (Link-16, TADIL-J, Azart, ASN-4), and C2 echelon (battery / battalion / brigade / regimental / theater).\n\nOutput format (plain prose, no JSON, no markdown code fences):\n1) Direct Answer — one short paragraph that directly resolves the user's question, with inline community citations.\n2) Supporting Evidence — 2-5 short paragraphs or a bulleted list walking through the relevant technical, operational, or relational findings from the cited reports. Every bullet/sentence must cite at least one community. Preserve the Direct / Inferred / Speculative labels from the reports.\n3) Conflicts & Gaps — bullets listing any disagreements between reports, missing designators, unresolved variants, absent geolocation, or intelligence the reports do not cover that would be needed to fully answer the question.\n4) Overall Confidence — Low | Medium | High, with a one-sentence justification based on report coverage, citation density, and internal consistency.\n\nDo not duplicate the reports verbatim. Do not list every source document — that is handled separately in response metadata; referencing community IDs is sufficient."

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4                       # Default (single worker, all queues)

# Split worker concurrency (used with `docker compose --profile split`)
WORKER_INGEST_CONCURRENCY=4                # celery,ingest,extract queues
WORKER_EMBED_CONCURRENCY=2                 # embed queue
WORKER_GRAPH_CONCURRENCY=2                 # graph,graph_extract queues

# ---------------------------------------------------------------------------
# Pipeline retry & time-limit settings (seconds)
# ---------------------------------------------------------------------------
PREPARE_MAX_RETRIES=3
PREPARE_RETRY_DELAY=300
PREPARE_SOFT_TIME_LIMIT=3600
PREPARE_TIME_LIMIT=4500

EMBED_MAX_RETRIES=10
EMBED_RETRY_DELAY=600
EMBED_SOFT_TIME_LIMIT=3600
EMBED_TIME_LIMIT=4500

GRAPH_MAX_RETRIES=2
GRAPH_RETRY_DELAY=600
GRAPH_SOFT_TIME_LIMIT=28800
GRAPH_TIME_LIMIT=32400

FINALIZE_MAX_RETRIES=1
FINALIZE_RETRY_DELAY=300
FINALIZE_SOFT_TIME_LIMIT=600
FINALIZE_TIME_LIMIT=900

# Celery soft/hard limits for derive_document_metadata (new explicit fields;
# previously derived inline as DOC_ANALYSIS_TIMEOUT+60/+120 in pipeline.py).
DOC_ANALYSIS_SOFT_TIME_LIMIT=1800
DOC_ANALYSIS_TIME_LIMIT=2400

# Max chain-level sweeper retries per doc. Beyond this, the doc is permanently
# FAILED for operator triage.
MAX_DOC_RETRY_COUNT=3

# Docling concurrency & health
DOCLING_CONCURRENCY=1                      # Max concurrent Docling conversions (Redis semaphore)
DOCLING_LOCK_TIMEOUT=3600                  # Auto-release if worker crashes
DOCLING_HEALTH_TIMEOUT=15.0                # Seconds to wait for Docling /health
DOCLING_503_MAX_RETRIES=20                 # In-task retry cap when Docling returns 503 (busy)

# Singleflight lock timeout for prepare_document (seconds)
PREPARE_SINGLEFLIGHT_TIMEOUT=4200

# ---------------------------------------------------------------------------
# Retrieval Scoring — Weighted Fusion
# ---------------------------------------------------------------------------
# Query defaults (exposed via /v1/settings/retrieval for frontend)
QUERY_DEFAULT_TOP_K=20
QUERY_DEFAULT_MIN_CONFIDENCE=0.1

# Score fusion weights (should sum to 1.0)
RETRIEVAL_SEMANTIC_WEIGHT=0.65
RETRIEVAL_DOC_STRUCTURE_WEIGHT=0.20
RETRIEVAL_ONTOLOGY_WEIGHT=0.15

# Retrieval diversity (content-level dedup)
RETRIEVAL_DIVERSITY_OVERSAMPLE_FACTOR=8
RETRIEVAL_DIVERSITY_MAX_CANDIDATES=800

# Document-structure link weights (chunk_links table)
RETRIEVAL_WEIGHT_NEXT_CHUNK=0.90
RETRIEVAL_WEIGHT_SAME_SECTION=0.88
RETRIEVAL_WEIGHT_SAME_ARTIFACT=0.82
RETRIEVAL_WEIGHT_SAME_PAGE=0.78

# Expansion limits
RETRIEVAL_DOC_EXPAND_K=5
RETRIEVAL_DOC_MAX_HOPS=2
RETRIEVAL_ONTOLOGY_EXPAND_K=5

# Hop penalty and bonuses
RETRIEVAL_HOP_PENALTY_BASE=0.92
RETRIEVAL_MIL_ID_BONUS=0.03

# Legacy decay (fallback for pre-v2 documents without chunk_links)
RETRIEVAL_CROSS_MODAL_DECAY=0.85
RETRIEVAL_ONTOLOGY_DECAY=0.75

# ---------------------------------------------------------------------------
# Reranker (cross-encoder for retrieval re-scoring)
# ---------------------------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu                        # cpu | cuda
RERANKER_ENABLED=true
RERANKER_TOP_N=20

# Minimum cosine similarity for results (below this, results are dropped)
RETRIEVAL_MIN_SCORE_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# Governance / Security
# ---------------------------------------------------------------------------
# When true, graph mutation patches require two distinct curator approvals
# before they can be applied. When false (default), one approval is enough.
GOVERNANCE_DUAL_APPROVAL_REQUIRED=false

# Default classification for documents that have no marking detected.
# Examples: UNCLASSIFIED | CUI | FOUO | SECRET | TOP SECRET
DEFAULT_CLASSIFICATION=UNCLASSIFIED

# ---------------------------------------------------------------------------
# Directory watcher
# ---------------------------------------------------------------------------
WATCH_DIR_POLL_INTERVAL_SECONDS=120

# ---------------------------------------------------------------------------
# Testing (only used with .env.test)
# ---------------------------------------------------------------------------
# TEST_SEED=42
# TEST_TIMEOUT_SECONDS=300
# KEEP_STACK=0
