+    @staticmethod
+    def _pages_from_source_refs(
+        document: Any, self_refs: list[str]
+    ) -> list[int]:
+        """Resolve page numbers for a chunk's ``source_refs`` against the
+        DoclingDocument (fallback when the caller didn't supply
+        ``page_numbers``). Looks up each self_ref via ``document.lookup`` (or
+        the ref-to-item map) and reads ``item.prov[].page_no``. Returns a
+        sorted unique list; empty when nothing resolves (genuinely page-less
+        — never fabricated)."""
+        if document is None or not self_refs:
+            return []
+        pages: set[int] = set()
+        lookup = getattr(document, "lookup", None)
+        for ref in self_refs:
+            item = None
+            if callable(lookup):
+                try:
+                    item = lookup(ref)
+                except Exception:
+                    item = None
+            if item is None:
+                continue
+            for prov in getattr(item, "prov", None) or []:
+                page_no = getattr(prov, "page_no", None)
+                if isinstance(page_no, int):
+                    pages.add(page_no)
+        return sorted(pages)
+
