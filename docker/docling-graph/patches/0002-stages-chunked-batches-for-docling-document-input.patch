+            # PATCH 2026-04-30: when extraction_contract == "delta" AND backend
+            # supports extract_from_chunk_batches AND a chunker is available,
+            # use the proper CHUNKED path (matches the documented delta flow at
+            # docs/extraction/delta-extraction.md: "Chunking -> Batch planning
+            # -> Per-batch LLM"). The original single-blob path -- export the
+            # whole DoclingDocument to markdown and run one extract_from_markdown
+            # call -- bypasses chunking entirely, sending the full ~23K-token
+            # markdown in ONE LLM call regardless of contract. That defeats
+            # delta's whole purpose: token-bounded batching with merge by
+            # identity. Empirically observed: chunk_count=1, batch_count=1 even
+            # when the chunker would produce 28 batches over 60 chunks. Result:
+            # entity NAMES found but per-entity numeric parameters lost
+            # (gemma4:31b attention diluted across 23K tokens). Single-blob
+            # path is preserved as the fallback for direct/staged contracts.
+            extractor_contract = getattr(context.extractor, "_extraction_contract", None)
+            can_chunk_batch = (
+                extractor_contract == "delta"
+                and hasattr(backend, "extract_from_chunk_batches")
+                and getattr(doc_processor, "chunker", None) is not None
             )
 
+            if can_chunk_batch:
+                logger.info(
+                    f"[{self.name()}] Using CHUNKED-BATCHES path "
+                    f"(extraction_contract='delta', chunker available) -- "
+                    f"matches documented delta flow."
+                )
+                chunks, chunk_metadata = doc_processor.extract_chunks_with_metadata(
+                    context.docling_document
+                )
+                # Emit per-chunk trace events so timeline shows chunking work
+                # was performed (mirrors the file-input path).
+                if context.trace_data:
+                    for cmeta, chunk_text in zip(chunk_metadata, chunks, strict=False):
+                        context.trace_data.emit(
+                            "chunk_created",
+                            "extraction",
+                            {
+                                "chunk_id": cmeta.get("chunk_id"),
+                                "token_count": cmeta.get("token_count"),
+                                "page_numbers": cmeta.get("page_numbers"),
+                                "text_content": chunk_text,
+                            },
+                        )
+                extracted_model = backend.extract_from_chunk_batches(
+                    chunks=chunks,
+                    chunk_metadata=chunk_metadata,
+                    template=context.template,
+                    context="DoclingDocument",
+                )
+                markdown_length_for_error = sum(len(c) for c in chunks)
+            else:
+                # Direct / staged contracts (or no chunker): single-blob path.
+                logger.info(
+                    f"[{self.name()}] Using SINGLE-BLOB path "
+                    f"(extraction_contract={extractor_contract!r}, "
+                    f"has_chunk_batches={hasattr(backend, 'extract_from_chunk_batches')}, "
+                    f"has_chunker={getattr(doc_processor, 'chunker', None) is not None})."
+                )
+                markdown_text = context.docling_document.export_to_markdown()
+
+                # Emit one docling_conversion event so the step appears in trace (conversion was pre-done)
+                if context.trace_data:
+                    context.trace_data.emit(
+                        "page_markdown_extracted",
+                        "extraction",
+                        {
+                            "page_number": 1,
+                            "text_content": markdown_text or "",
+                            "metadata": {"source": "docling_document"},
+                        },
+                    )
+
+                extracted_model = backend.extract_from_markdown(
+                    markdown=markdown_text,
+                    template=context.template,
+                    context="DoclingDocument",
+                    is_partial=False,
+                )
+                markdown_length_for_error = len(markdown_text)
+
             if not extracted_model:
