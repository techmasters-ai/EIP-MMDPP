+    @staticmethod
+    def _build_field_subset_schema(
+        template: Type[BaseModel],
+        field_subset: list[str] | None,
+    ) -> str:
+        """Build a JSON schema string for the LLM prompt, optionally restricted
+        to a subset of fields (Task F3, §9 subset-schema extraction).
+
+        When *field_subset* is None (the default) the full schema is returned
+        byte-identical to ``_get_schema_json(template)``.
+
+        When *field_subset* is a non-empty list, a **new restricted schema dict**
+        is built containing only the fields in *field_subset* PLUS any
+        pydantic-required fields (those the model declares without a default
+        value).  The live template/record class is NEVER mutated — the filter
+        operates on a deep copy of the schema dict.  All ``$defs`` entries are
+        kept intact (unreferenced defs are harmless; removing them would require
+        a full ref-walk).
+
+        The final validation after extraction always uses the FULL template
+        class — only the prompt schema seen by the LLM is narrowed.
+
+        Args:
+            template:     Pydantic model class (not mutated).
+            field_subset: List of field names to include, or None for full schema.
+
+        Returns:
+            JSON string to pass as ``schema_json`` in the LLM prompt.
+        """
+        import copy as _copy
+
+        full_schema = template.model_json_schema()
+
+        if field_subset is None:
+            # Byte-identical to _get_schema_json (same indent, same ordering).
+            return json.dumps(full_schema, indent=2)
+
+        # Pydantic-required fields: those the model declares without a default
+        # (present in the JSON schema's top-level "required" array).
+        pydantic_required: set[str] = set(full_schema.get("required") or [])
+
+        # Keep = explicitly requested ∪ pydantic-required (defensive inclusion).
+        keep: set[str] = set(field_subset) | pydantic_required
+
+        # Deep-copy to avoid ANY mutation of the live class's cached schema.
+        restricted = _copy.deepcopy(full_schema)
+
+        all_props: dict[str, Any] = restricted.get("properties") or {}
+        restricted["properties"] = {k: v for k, v in all_props.items() if k in keep}
+
+        # Narrow the "required" list to only kept fields.
+        if "required" in restricted:
+            restricted["required"] = [r for r in restricted["required"] if r in keep]
+
+        # $defs are retained intact — see docstring.
+        return json.dumps(restricted, indent=2)
+
