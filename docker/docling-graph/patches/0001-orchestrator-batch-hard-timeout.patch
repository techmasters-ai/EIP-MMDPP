+def _drain_futures_with_progress_watchdog(
+    futures_map,
+    no_progress_seconds,
+    *,
+    wait=None,
+):
+    """No-progress (inter-arrival) watchdog over a map of {future: original_idx}.
+
+    PATCH 2026-06-13 (R1): replaces the previous total-elapsed BATCH_HARD ceiling.
+    The old code wrapped the loop in ``as_completed(futures, timeout=T)`` +
+    ``future.result(timeout=T)``. ``as_completed``'s timeout is the TOTAL wall
+    budget for iterating over ALL futures, not per-batch, so a large doc whose
+    legitimate aggregate batch time exceeds ``T`` (e.g. 174 batches / 2 workers)
+    had its healthy queued futures cancelled and mis-degraded to the slow
+    sequential split-retry.
+
+    This watchdog measures the INTER-ARRIVAL gap instead: it only trips when NO
+    future completes within a single ``no_progress_seconds`` slice. A slow but
+    progressing pass (each batch finishing within the window of the previous
+    completion) never trips, independent of N; a genuinely deadlocked pool
+    (every worker stuck, zero completions) trips within one window.
+
+    Yields ``(future, original_idx, result)`` for each completed future (result
+    is ``future.result()`` with NO timeout — the per-LLM-call stream wall-timeout
+    already bounds a single call; this detector handles the deadlock class).
+    Returns the set of still-pending futures that were hung when a stall tripped
+    (empty set if every future drained). The caller cancels the returned hung
+    futures and routes them to failed_batches with a BATCH_NO_PROGRESS message.
+    """
+    import concurrent.futures as _cf
+
+    if wait is None:
+        wait = _cf.wait
+    pending = set(futures_map.keys())
+    while pending:
+        done, not_done = wait(
+            pending,
+            timeout=no_progress_seconds,
+            return_when=_cf.FIRST_COMPLETED,
+        )
+        if not done:
+            # A full no-progress slice elapsed with zero completions -> stall.
+            return set(not_done)
+        for _future in done:
+            yield _future, futures_map[_future], _future.result()
+        pending = not_done
+    return set()
+
+
